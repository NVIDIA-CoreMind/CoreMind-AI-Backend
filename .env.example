# ─── Nebius / NVIDIA Nemotron ───────────────────────────────────────
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# ─── CoreMind Backend ──────────────────────────────────────────────
COREMIND_BACKEND_HOST=127.0.0.1
COREMIND_BACKEND_PORT=43110

# ─── Agent Limits ──────────────────────────────────────────────────
MAX_AGENT_STEPS=20
DEFAULT_COMMAND_TIMEOUT_MS=120000
MEMORY_MAX_ITEMS=40
MEMORY_MAX_CONTENT_CHARS=400
MEMORY_PROMPT_ITEMS=8
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_S=12
TAVILY_API_KEY=your_tavily_api_key_here


# ─── Sandbox ───────────────────────────────────────────────────────
SANDBOX_TYPE=local
SANDBOX_WORKING_DIR=

# ─── Authentication & JWT ──────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Google OAuth ──────────────────────────────────────────────────
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:43110/v1/auth/google/callback
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ─── Database ──────────────────────────────────────────────────────
SQLITE_DB_PATH=data/coremind.db

# ─── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=info
