# Copy to deploy/oracle/backend.env on the VM and fill in real values.
# Never commit the real file. Secrets belong only on the VM.

# Use a newly rotated Nebius key, not the one that was exposed.
NEBIUS_API_KEY=replace-with-rotated-nebius-key

# At least 32 random characters. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-random-value-of-32-plus-characters

# Comma-separated browser origins allowed by CORS. The packaged desktop app
# loads from file://; check which Origin header it sends before relying on this.
FRONTEND_ORIGIN=http://localhost:5173

# Google sign-in. The redirect URI must match the one registered in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://replace-with-your-domain/v1/auth/google/callback

SQLITE_DB_PATH=data/coremind.db
